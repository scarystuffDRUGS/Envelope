ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');
FILE_NAME('synthetic-block.ifc','2026-10-26T00:00:00',('Envelope'),('Envelope'),'Hand-written test model','Envelope','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Hand-built test model for the importer (fixtures/import/README.md). Lengths in millimetres.
   Expected: 3 floors at 3.5 m, 1 basement 3.0 m deep, 20 m x 10 m footprint, windows 2 x 1.8 m2
   on the south face and 1 x 1.8 m2 on the north face, 4 slabs x 40 m3 = 160 m3 concrete,
   site 18 31 12 N, 73 51 36 E, true north rotated 30 degrees (model +Y at bearing 30). */
#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#2=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#3=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#4=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#5=IFCUNITASSIGNMENT((#1,#2,#3,#4));
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,0.,1.));
#12=IFCDIRECTION((1.,0.,0.));
#13=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14=IFCDIRECTION((-0.5,0.8660254037844386));
#15=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#13,#14);
#16=IFCGEOMETRICREPRESENTATIONSUBCONTEXT('Body','Model',*,*,*,*,#15,$,.MODEL_VIEW.,$);
#20=IFCPROJECT('0YvctVUKr0kugbFTf53O9L',$,'Envelope synthetic block',$,$,$,$,(#15),#5);
#30=IFCLOCALPLACEMENT($,#13);
#31=IFCSITE('0YvctVUKr0kugbFTf53O9M',$,'Pune test site',$,$,#30,$,$,.ELEMENT.,(18,31,12,0),(73,51,36,0),560.,$,$);
#40=IFCLOCALPLACEMENT(#30,#13);
#41=IFCBUILDING('0YvctVUKr0kugbFTf53O9N',$,'Synthetic office block',$,$,#40,$,$,.ELEMENT.,$,$,$);
#50=IFCCARTESIANPOINT((0.,0.,-3000.));
#51=IFCAXIS2PLACEMENT3D(#50,#11,#12);
#52=IFCLOCALPLACEMENT(#40,#51);
#53=IFCBUILDINGSTOREY('0YvctVUKr0kugbFTf53O9O',$,'Basement',$,$,#52,$,$,.ELEMENT.,-3000.);
#54=IFCLOCALPLACEMENT(#40,#13);
#55=IFCBUILDINGSTOREY('0YvctVUKr0kugbFTf53O9P',$,'Ground floor',$,$,#54,$,$,.ELEMENT.,0.);
#56=IFCCARTESIANPOINT((0.,0.,3500.));
#57=IFCAXIS2PLACEMENT3D(#56,#11,#12);
#58=IFCLOCALPLACEMENT(#40,#57);
#59=IFCBUILDINGSTOREY('0YvctVUKr0kugbFTf53O9Q',$,'First floor',$,$,#58,$,$,.ELEMENT.,3500.);
#60=IFCCARTESIANPOINT((0.,0.,7000.));
#61=IFCAXIS2PLACEMENT3D(#60,#11,#12);
#62=IFCLOCALPLACEMENT(#40,#61);
#63=IFCBUILDINGSTOREY('0YvctVUKr0kugbFTf53O9R',$,'Second floor',$,$,#62,$,$,.ELEMENT.,7000.);
#64=IFCCARTESIANPOINT((0.,0.,10500.));
#65=IFCAXIS2PLACEMENT3D(#64,#11,#12);
#66=IFCLOCALPLACEMENT(#40,#65);
#67=IFCBUILDINGSTOREY('0YvctVUKr0kugbFTf53O9S',$,'Roof',$,$,#66,$,$,.ELEMENT.,10500.);
#70=IFCRELAGGREGATES('0YvctVUKr0kugbFTf53O9T',$,$,$,#20,(#31));
#71=IFCRELAGGREGATES('0YvctVUKr0kugbFTf53O9U',$,$,$,#31,(#41));
#72=IFCRELAGGREGATES('0YvctVUKr0kugbFTf53O9V',$,$,$,#41,(#53,#55,#59,#63,#67));
/* Slab geometry: 20 m x 10 m x 200 mm, top face at the storey level. */
#80=IFCCARTESIANPOINT((0.,0.));
#81=IFCAXIS2PLACEMENT2D(#80,$);
#82=IFCRECTANGLEPROFILEDEF(.AREA.,'Slab 20x10',#81,20000.,10000.);
#83=IFCCARTESIANPOINT((0.,0.,-200.));
#84=IFCAXIS2PLACEMENT3D(#83,#11,#12);
#85=IFCEXTRUDEDAREASOLID(#82,#84,#11,200.);
#86=IFCSHAPEREPRESENTATION(#16,'Body','SweptSolid',(#85));
#87=IFCPRODUCTDEFINITIONSHAPE($,$,(#86));
#90=IFCLOCALPLACEMENT(#52,#13);
#91=IFCSLAB('0YvctVUKr0kugbFTf53O9W',$,'Basement slab',$,$,#90,#87,$,.FLOOR.);
#92=IFCLOCALPLACEMENT(#54,#13);
#93=IFCSLAB('0YvctVUKr0kugbFTf53O9X',$,'Ground slab',$,$,#92,#87,$,.FLOOR.);
#94=IFCLOCALPLACEMENT(#58,#13);
#95=IFCSLAB('0YvctVUKr0kugbFTf53O9Y',$,'First slab',$,$,#94,#87,$,.FLOOR.);
#96=IFCLOCALPLACEMENT(#62,#13);
#97=IFCSLAB('0YvctVUKr0kugbFTf53O9Z',$,'Second slab',$,$,#96,#87,$,.FLOOR.);
/* Window geometry: 1500 mm wide, 100 mm deep, 1200 mm high. */
#100=IFCRECTANGLEPROFILEDEF(.AREA.,'Window 1500',#81,1500.,100.);
#101=IFCAXIS2PLACEMENT3D(#10,#11,#12);
#102=IFCEXTRUDEDAREASOLID(#100,#101,#11,1200.);
#103=IFCSHAPEREPRESENTATION(#16,'Body','SweptSolid',(#102));
#104=IFCPRODUCTDEFINITIONSHAPE($,$,(#103));
#110=IFCCARTESIANPOINT((-5000.,-4950.,900.));
#111=IFCAXIS2PLACEMENT3D(#110,#11,#12);
#112=IFCLOCALPLACEMENT(#54,#111);
#113=IFCWINDOW('0YvctVUKr0kugbFTf53Oa0',$,'South window 1',$,$,#112,#104,$,1200.,1500.,.WINDOW.,.SINGLE_PANEL.,$);
#114=IFCCARTESIANPOINT((5000.,-4950.,900.));
#115=IFCAXIS2PLACEMENT3D(#114,#11,#12);
#116=IFCLOCALPLACEMENT(#54,#115);
#117=IFCWINDOW('0YvctVUKr0kugbFTf53Oa1',$,'South window 2',$,$,#116,#104,$,1200.,1500.,.WINDOW.,.SINGLE_PANEL.,$);
#118=IFCCARTESIANPOINT((0.,4950.,900.));
#119=IFCAXIS2PLACEMENT3D(#118,#11,#12);
#120=IFCLOCALPLACEMENT(#54,#119);
#121=IFCWINDOW('0YvctVUKr0kugbFTf53Oa2',$,'North window',$,$,#120,#104,$,1200.,1500.,.WINDOW.,.SINGLE_PANEL.,$);
#130=IFCRELCONTAINEDINSPATIALSTRUCTURE('0YvctVUKr0kugbFTf53Oa3',$,$,$,(#91),#53);
#131=IFCRELCONTAINEDINSPATIALSTRUCTURE('0YvctVUKr0kugbFTf53Oa4',$,$,$,(#93,#113,#117,#121),#55);
#132=IFCRELCONTAINEDINSPATIALSTRUCTURE('0YvctVUKr0kugbFTf53Oa5',$,$,$,(#95),#59);
#133=IFCRELCONTAINEDINSPATIALSTRUCTURE('0YvctVUKr0kugbFTf53Oa6',$,$,$,(#97),#63);
/* Base quantities: each slab 20 x 10 x 0.2 = 40 m3. */
#140=IFCQUANTITYVOLUME('NetVolume',$,$,40.,$);
#141=IFCELEMENTQUANTITY('0YvctVUKr0kugbFTf53Oa7',$,'Qto_SlabBaseQuantities',$,$,(#140));
#142=IFCRELDEFINESBYPROPERTIES('0YvctVUKr0kugbFTf53Oa8',$,$,$,(#91,#93,#95,#97),#141);
/* Occupancy for the use mapping. */
#150=IFCPROPERTYSINGLEVALUE('OccupancyType',$,IFCLABEL('Office'),$);
#151=IFCPROPERTYSET('0YvctVUKr0kugbFTf53Oa9',$,'Pset_BuildingCommon',$,(#150));
#152=IFCRELDEFINESBYPROPERTIES('0YvctVUKr0kugbFTf53OaA',$,$,$,(#41),#151);
ENDSEC;
END-ISO-10303-21;
