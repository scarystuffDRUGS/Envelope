# Copy to .env and fill in. Never commit .env. Never paste keys into chat or code.

# Cesium ion access token (ion.cesium.com → Access Tokens). Scope: assets:read, geocode.
# Restrict allowed URLs to http://localhost:5173 and your Vercel domain(s). Served to the browser at runtime by /api/config.
# On Vercel, set these in Project → Settings → Environment Variables instead of a .env file (README, Deploy to Vercel).
CESIUM_ION_TOKEN=

# Optional backup basemap: Google Maps Platform key with Map Tiles API enabled.
GOOGLE_MAPS_API_KEY=

# Report narrative LLMs (server-side only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: OpenAQ v3 ground stations (server-side only).
OPENAQ_API_KEY=

# Server
SERVER_PORT=8787

# Abuse guards on Vercel (optional; defaults shown). Per visitor IP, per server instance; off in local runs.
REPORT_RATE_LIMIT=5
REPORT_RATE_WINDOW_MIN=10
SITE_DATA_RATE_LIMIT=60
